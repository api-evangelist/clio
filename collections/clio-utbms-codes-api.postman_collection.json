{
  "item": [
    {
      "id": "a9e7ee2e-ab7f-414c-b4c8-bb211d8121fd",
      "name": "Utbms Codes",
      "description": {
        "content": "[UTBMS codes](http://utbms.com/) standardize Time and Expense entries across the legal profession. Clio users can enter their Activities using UTBMS codes in order to provide electronic invoices.\n\n[Support Link](https://help.clio.com/hc/en-us/articles/9289762435099-UTBMS-Codes)\n",
        "type": "text/plain"
      },
      "item": [
